# Локально скопируй в .env:  copy .env.example .env

# Образ Node для сборки Docker (по умолчанию в compose — зеркало GCR). Если нужен прямой Hub:
# NODE_IMAGE=node:20-alpine

DATABASE_URL=postgresql://user:password@localhost:5432/kitsune

# NextAuth (в dev сгенерируй длинную случайную строку)
NEXTAUTH_SECRET=replace-with-long-random-string
# Без слэша в конце; для Docker по умолчанию http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret

